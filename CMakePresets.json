{
    "version": 9,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 3,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/build/install/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "ninja-base",
            "hidden": true,
            "inherits": "windows-base",
            "generator": "Ninja",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "x64-debug",
            "displayName": "x64 Debug",
            "inherits": "ninja-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "clang-cl-base",
            "hidden": true,
            "inherits": "ninja-base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/Llvm/x64/bin/clang-cl.exe",
                "CMAKE_LINKER": "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/Llvm/x64/bin/lld-link.exe"
            }
        },
        {
            "name": "x64-clang-debug",
            "displayName": "x64 Debug (clang-cl + lld-link)",
            "inherits": "clang-cl-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "x64-clang-release",
            "displayName": "x64 Release (clang-cl + lld-link)",
            "inherits": "clang-cl-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "x64-clang-relwithdebinfo",
            "displayName": "x64 RelWithDebInfo (clang-cl + lld-link)",
            "inherits": "clang-cl-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "x64-release",
            "displayName": "x64 Release",
            "inherits": "ninja-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "x64-relwithdebinfo",
            "displayName": "x64 RelWithDebInfo",
            "inherits": "ninja-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "x64-asan",
            "displayName": "x64 AddressSanitizer + fuzzer",
            "inherits": "ninja-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "STRATA_ASAN": "ON",
                "STRATA_BUILD_FUZZERS": "ON"
            }
        },
        {
            "name": "vs2022",
            "displayName": "Visual Studio 2022 solution",
            "inherits": "windows-base",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "x64-debug",
            "configurePreset": "x64-debug"
        },
        {
            "name": "x64-release",
            "configurePreset": "x64-release"
        },
        {
            "name": "x64-relwithdebinfo",
            "configurePreset": "x64-relwithdebinfo"
        },
        {
            "name": "x64-clang-debug",
            "configurePreset": "x64-clang-debug"
        },
        {
            "name": "x64-clang-release",
            "configurePreset": "x64-clang-release"
        },
        {
            "name": "x64-clang-relwithdebinfo",
            "configurePreset": "x64-clang-relwithdebinfo"
        },
        {
            "name": "x64-asan",
            "configurePreset": "x64-asan"
        },
        {
            "name": "vs2022-debug",
            "configurePreset": "vs2022",
            "configuration": "Debug"
        },
        {
            "name": "vs2022-release",
            "configurePreset": "vs2022",
            "configuration": "Release"
        }
    ]
}
